{
  "expo": {
    "name": "project-alpha",
    "slug": "project-alpha",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "projectalpha",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.projectalpha.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6E7EA"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
